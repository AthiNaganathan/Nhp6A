;
; Protein-only topology for 1Nhp6A (WT Nhp6A), apo form.
; Derived from 1Nhp6A_DNA_parambsc1_tip3p_ions.top: DNA chains removed.
; SOL and ion counts are left absent — gmx solvate and gmx genion will add them.
;

; Include forcefield parameters
#include "./amber14sb_parmbsc1.ff/forcefield.itp"

; Include chain topologies
#include "1Nhp6A_DNA_parambsc1_tip3p_Protein_chain_A.itp"

; Include water topology
#include "./amber14sb_parmbsc1.ff/tip3p.itp"

#ifdef POSRES_WATER
; Position restraint for each water oxygen
[ position_restraints ]
;  i funct       fcx        fcy        fcz
   1    1       1000       1000       1000
#endif

; Include topology for ions
#include "./amber14sb_parmbsc1.ff/ions.itp"

[ system ]
; Name
Protein in water

[ molecules ]
; Compound        #mols
Protein_chain_A     1
SOL         15991
K                46
CL               54
