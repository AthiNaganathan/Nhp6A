# 1IDR: Nhp6A IDR peptide (res 1-23, C-amide) + DNA, 2D WT-MetaD, wall variant.
# Generated 2026-10-08 from plumed_meta_2D_1Nhp6A_wall.dat: identical CVs/bias/walls; DNA atom
# indices shifted by -1124 (DNA 1540-2489 -> 416-1365); IDR group (res 1-20 CA+CB) unchanged.
MOLINFO STRUCTURE=1IDR_DNA_parambsc1_tip3p.pdb
FIT_TO_TEMPLATE REFERENCE=1IDR_DNA_parambsc1_tip3p.pdb
WHOLEMOLECULES ENTITY0=416-1365

## geometric centers
dna_center: COM ATOMS=416-1365
dna_end1: COM ATOMS=416-446,1335-1365
dna_end2: COM ATOMS=900-927,866-899

# angle
theta: ANGLE ATOMS=dna_end1,dna_center,dna_end2

## de2e
de2e: DISTANCE ATOMS=dna_end1,dna_end2 NOPBC

# --- Tail and DNA backbone groups ---
# CA + Cbeta of residues 1-20 (N-terminal disordered tail)
tail: GROUP ATOMS=5,7,22,24,38,40,57,60,66,68,90,92,110,113,119,121,141,143,163,165,187,189,201,203,215,217,239,241,261,263,283,285,305,307,322,325,331,333,345,347
# P + C1' of all nucleotides (both strands, ~2 atoms/nt)
dna_backbone: GROUP ATOMS=424,447,457,480,490,513,523,546,556,578,588,611,621,643,653,675,685,707,717,740,750,772,782,804,814,834,844,866,876,908,928,938,960,970,993,1003,1025,1035,1057,1067,1087,1097,1119,1129,1151,1161,1183,1193,1213,1223,1245,1255,1275,1285,1305,1315,1335,1345

# --- New CV ---
# Coordination between N-terminal tail and DNA backbone/base positions
coord_tail_dna: COORDINATION GROUPA=tail GROUPB=dna_backbone R_0=0.5 NN=6 MM=12

## restraint on DNA double-helix integrity (inter-strand contacts)
