   ATOMS139=826,980 SWITCH139={Q R_0=0.1 BETA=50.0 LAMBDA=1.4 REF=0.29} WEIGHT139=0.0070922
   ATOMS140=827,980 SWITCH140={Q R_0=0.1 BETA=50.0 LAMBDA=1.4 REF=0.28} WEIGHT140=0.0070922
