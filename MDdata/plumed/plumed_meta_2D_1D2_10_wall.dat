# 1D2_10: Nhp6A delta2-10 + DNA. Generated 2026-10-28 from plumed_meta_2D_1Nhp6A_wall.dat: identical CVs/bias/walls;
# DNA indices shifted by -165 (1540-2489 -> 1375-2324); IDR group = WT residues 1,11-20 (new 1-11) CA+CB.
MOLINFO STRUCTURE=1D2_10_DNA_parambsc1_tip3p.pdb
FIT_TO_TEMPLATE REFERENCE=1D2_10_DNA_parambsc1_tip3p.pdb
WHOLEMOLECULES ENTITY0=1375-2324

## geometric centers
dna_center: COM ATOMS=1375-2324
dna_end1: COM ATOMS=1375-1405,2294-2324
dna_end2: COM ATOMS=1859-1886,1825-1858

# angle
theta: ANGLE ATOMS=dna_end1,dna_center,dna_end2

## de2e
de2e: DISTANCE ATOMS=dna_end1,dna_end2 NOPBC

# --- Tail and DNA backbone groups ---
# CA + Cbeta of the surviving IDR residues: WT 1,11-20 = 1D2_10 residues 1-11 (22 atoms)
tail: GROUP ATOMS=5,7,22,24,36,38,50,52,74,76,96,98,118,120,140,142,157,160,166,168,180,182
# P + C1' of all nucleotides (both strands, ~2 atoms/nt)
dna_backbone: GROUP ATOMS=1383,1406,1416,1439,1449,1472,1482,1505,1515,1537,1547,1570,1580,1602,1612,1634,1644,1666,1676,1699,1709,1731,1741,1763,1773,1793,1803,1825,1835,1867,1887,1897,1919,1929,1952,1962,1984,1994,2016,2026,2046,2056,2078,2088,2110,2120,2142,2152,2172,2182,2204,2214,2234,2244,2264,2274,2294,2304

# --- New CV ---
# Coordination between N-terminal tail and DNA backbone/base positions
coord_tail_dna: COORDINATION GROUPA=tail GROUPB=dna_backbone R_0=0.5 NN=6 MM=12

## restraint on DNA double-helix integrity (inter-strand contacts)
