n_tail_core: COORDINATION GROUPA=tail GROUPB=core R_0=0.5 NN=6 MM=12

# Per-helix helicity (monitored only): ALPHARMSD over DSSP-derived ranges
helix1: ALPHARMSD RESIDUES=27-42
helix2: ALPHARMSD RESIDUES=48-61
helix3: ALPHARMSD RESIDUES=64-91

wall_core: UPPER_WALLS ARG=rmsd_core AT=0.5 KAPPA=5000 EXP=2 OFFSET=0

metad: METAD ARG=q_core,n_tail_core ...
   PACE=500 HEIGHT=1.2
   SIGMA=0.025,1.5
   BIASFACTOR=10 TEMP=298
