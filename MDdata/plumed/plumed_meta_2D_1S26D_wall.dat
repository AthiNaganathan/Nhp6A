## soft LOWER_WALLS on DNA double-helix integrity (inter-strand contacts)
## replaces the stiff two-sided RESTRAINT (AT=0.96); inactive above Q=0.9,
## only resists melting below it -> free base-pair breathing above the wall
dwall: LOWER_WALLS ARG=cmap AT=0.9 KAPPA=5000 EXP=2 EPS=1 OFFSET=0

# --- 2D well-tempered metadynamics, file-based multiple walkers ---
# REPID is replaced by sed in slurm script (0-5)
metad: METAD ARG=coord_tail_dna,de2e ...
   PACE=500 HEIGHT=2.0
   SIGMA=3.0,0.25
   BIASFACTOR=5 TEMP=298
   FILE=hills.dat
   GRID_MIN=0,0  GRID_MAX=150,8  GRID_BIN=100,200
   WALKERS_N=6 WALKERS_ID=REPID WALKERS_DIR=../
   WALKERS_RSTRIDE=500
...

bias: REWEIGHT_BIAS ARG=metad.bias
hh_de2e: HISTOGRAM ARG=de2e STRIDE=100 GRID_MIN=0 GRID_MAX=8 GRID_BIN=200 BANDWIDTH=0.05 LOGWEIGHTS=bias
ff_de2e: CONVERT_TO_FES GRID=hh_de2e

DUMPGRID GRID=ff_de2e FILE=fes_de2e_rREPID.dat

PRINT ARG=coord_tail_dna,de2e,theta,cmap STRIDE=100 FILE=colvar_rREPID.dat
