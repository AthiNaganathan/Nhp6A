WHOLEMOLECULES ENTITY0=1541-2490
FIT_TO_TEMPLATE REFERENCE=1S26D_DNA_parambsc1.pdb

## geometric centers
dna_center: COM ATOMS=1541-2490
dna_end1: COM ATOMS=1541-1571,2460-2490
dna_end2: COM ATOMS=2025-2052,1991-2024

# angle
theta: ANGLE ATOMS=dna_end1,dna_center,dna_end2

## de2e
de2e: DISTANCE ATOMS=dna_end1,dna_end2 NOPBC

# --- Tail and DNA backbone groups ---
# CA + Cbeta of residues 1-20 (N-terminal disordered tail)
